<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Platforms>x64</Platforms>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<PackageId>CTDL.Schema.SDK</PackageId>
		<Version>1.0.0</Version>
		<Authors>Credential Engine</Authors>
		<Company>Credential Engine</Company>

		<Description>CTDL Schema API library</Description>

		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

		<RepositoryUrl>https://github.com/CredentialEngine/Schema-Development</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/CredentialEngine/Schema-Development</PackageProjectUrl>

		<Copyright>Copyright (c) Credential Engine</Copyright>

		<PackageTags>ctdl rdf jsonld schema</PackageTags>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="dotNetRdf" Version="3.5.1"/>
		<PackageReference Include="JsonPath.Net" Version="3.0.2"/>
	</ItemGroup>

</Project>
