{
  "@context": "https://credreg.net/ctdl/schema/context/json",
  "@type": "rdf:Property",
  "@id": "ceterms:sourceNode",
  "rdfs:label": {
    "en-US": "Source Node"
  },
  "rdfs:comment": {
    "en-US": "Individual entry in a formally defined framework that is the source of an alignment."
  },
  "dct:description": {
    "en-US": "This is the node to which the target node is being compared. It is the subject of the property used as the alignment type."
  },
  "vann:usageNote": {
    "en-US": "\"Framework\" may be interpreted broadly to include any scheme or schema for organizing and referencing resources."
  },
  "vs:term_status": "vs:unstable",
  "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/sourceNode/json",
  "schema:domainIncludes": [
    "ceterms:AlignmentObject"
  ],
  "schema:rangeIncludes": [
    "xsd:anyURI"
  ]
}