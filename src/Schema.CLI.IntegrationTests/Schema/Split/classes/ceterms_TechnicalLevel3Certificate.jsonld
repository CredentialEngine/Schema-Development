{
  "@context": "https://credreg.net/ctdl/schema/context/json",
  "@type": "rdfs:Class",
  "@id": "ceterms:TechnicalLevel3Certificate",
  "rdfs:label": {
    "en-US": "Technical Level 3 Certificate"
  },
  "rdfs:comment": {
    "en-US": "Credential award at a postsecondary level for successful completion of a formal education program that is at least 2 years but less than 4 years, demonstrating competencies within specific occupational areas indicating job readiness."
  },
  "dct:description": {
    "en-US": "Can lead to a degree. Equivalent to a United States IPEDS Award Level 4 that specifies certificates of 1,800 or more clock hours, or 60 or more semester or trimester credit hours, or 90 or more quarter credit hours and UNESCO ISCED 2011 Level 5."
  },
  "vs:term_status": "vs:unstable",
  "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/TechnicalLevel3Certificate/json",
  "rdfs:subClassOf": [
    "ceterms:AcademicCertificate"
  ],
