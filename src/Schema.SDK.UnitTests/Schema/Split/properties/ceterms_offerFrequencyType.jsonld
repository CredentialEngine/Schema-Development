{
    "@context": "https://credreg.net/ctdl/schema/context/json",
    "@type": "rdf:Property",
    "@id": "ceterms:offerFrequencyType",
    "rdfs:label": {
        "en-US": "Offer Frequency Type"
    },
    "rdfs:comment": {
        "en-US": "Type of frequency at which a resource is offered; select from an existing enumeration of such types."
    },
    "dct:description": {
        "en-US": "This relates to how often something starts."
    },
    "vann:usageNote": {
        "en-US": "For information relating to the frequency of events associated with a resource when it is running, use ceterms:scheduleFrequencyType."
    },
    "vs:term_status": "vs:unstable",
    "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/offerFrequencyType/json",
    "schema:domainIncludes": [
        "ceterms:AssessmentProfile",
        "ceterms:Course",
        "ceterms:LearningOpportunityProfile",
        "ceterms:LearningProgram",
        "ceterms:ScheduledOffering"
    ],
    "schema:rangeIncludes": [
        "ceterms:CredentialAlignmentObject"
    ],
    "meta:targetScheme": [
        "ceterms:ScheduleFrequency"
    ]
}