{
    "@context": "https://credreg.net/ctdl/schema/context/json",
    "@type": "rdf:Property",
    "@id": "ceterms:isAdvancedStandingFor",
    "rdfs:label": {
        "en-US": "Is Advanced Standing For"
    },
    "rdfs:comment": {
        "en-US": "This resource reduces the time or cost required to earn or complete the referenced resource."
    },
    "vann:usageNote": {
        "en-US": "A third-party credential agent claiming that its credential provides advanced standing for the credential of another credential agent should consider using ceterms:recommendedFor instead of ceterms:advancedStandingFor in the absence of an explicit and verifiable agreement on advanced standing between the agents of the two credentials."
    },
    "vs:term_status": "vs:stable",
    "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/isAdvancedStandingFor/json",
