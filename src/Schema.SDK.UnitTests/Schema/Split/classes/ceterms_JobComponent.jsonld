        "ceterms:ctid",
        "ceterms:description",
        "ceterms:hasCondition",
        "ceterms:identifier",
        "ceterms:industryType",
        "ceterms:isDestinationComponentOf",
        "ceterms:isPartOf",
        "ceterms:name",
        "ceterms:occupationType",
        "ceterms:pointValue",
        "ceterms:precededBy",
        "ceterms:precedes",
        "ceterms:proxyFor",
        "ceterms:sourceData",
        "ceterms:subjectWebpage"
    ]
}