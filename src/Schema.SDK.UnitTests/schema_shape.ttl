@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<#ClassMetaShape>
    a sh:NodeShape ;
    sh:targetClass rdfs:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every class in the schema must have at least one rdfs:label." ;
    ] .

<#PropertyMetaShape>
    a sh:NodeShape ;
    sh:targetClass rdfs:Property ;
    sh:property [
        sh:path schema:domainIncludes ;
        sh:minCount 1 ;
        sh:message "Every property should define an schema:domainIncludes." ;
    ] ;
    sh:property [
        sh:path schema:rangeIncludes ;
        sh:minCount 1 ;
        sh:message "Every property should define an schema:rangeIncludes." ;
    ] .