    "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/demographicInformation/json",
    "schema:domainIncludes": [
        "ceterms:AggregateDataProfile",
        "ceterms:HoldersProfile"
    ],
    "schema:rangeIncludes": [
        "rdf:langString"
    ]
}