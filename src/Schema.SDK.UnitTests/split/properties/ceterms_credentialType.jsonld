{
    "@context": "https://credreg.net/ctdl/schema/context/json",
    "@type": "rdf:Property",
    "@id": "ceterms:credentialType",
    "rdfs:label": {
        "en-US": "Credential Type"
    },
    "rdfs:comment": {
        "en-US": "Indicates the specific type of credential or qualification of this resource."
    },
    "vann:usageNote": {
        "en-US": "Use to identify a more specific type than is provided using the rdf:type (JSON-LD \"@type\") property. For example, resources with type CredentialComponent may identify a specific subclass of ceterms:Credential; resources typed as a subclass of ceterms:Credential may identify a specific instance of ceterms:CredentialType."
    },
    "vs:term_status": "vs:stable",
