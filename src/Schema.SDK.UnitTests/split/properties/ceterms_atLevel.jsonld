{
    "@context": "https://credreg.net/ctdl/schema/context/json",
    "@type": "rdf:Property",
    "@id": "ceterms:atLevel",
    "rdfs:label": {
        "en-US": "At Level"
    },
    "rdfs:comment": {
        "en-US": "Indicates the stage or level of achievement in a progression of learning."
    },
    "vann:usageNote": {
        "en-US": "Indicates the level an audience will hold upon completion or attainment. To indicate the level of the audience that should be qualified to pursue this resource, use audienceLevel."
    },
