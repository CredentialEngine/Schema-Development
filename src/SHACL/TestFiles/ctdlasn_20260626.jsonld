            "skos:prefLabel": {
                "en-US": "External"
            },
            "skos:definition": {
                "en-US": "Evaluator is an agent who is outside the context of the person, group, or thing being evaluated."
            },
            "dct:description": {
                "en-US": "Evaluator is typically independent of the person, group, or thing being evaluated."
