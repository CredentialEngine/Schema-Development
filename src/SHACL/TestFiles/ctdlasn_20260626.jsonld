            "skos:prefLabel": {
                "en-US": "Peer"
            },
            "skos:definition": {
                "en-US": "Evaluator is one or more peers of the person, group, or thing being evaluated."
            },
            "dct:description": {
                "en-US": "Peers may be people taking the same course or in similar job roles."
            },
            "vs:term_status": "vs:unstable",
