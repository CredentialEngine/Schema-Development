                "en-US": "Specialist Degree"
            },
            "rdfs:comment": {
                "en-US": "Credential awarded for a graduate level course of study where course work and activities advance skills beyond those of the master’s degree and less than a doctoral degree and provide specific preparation for advanced careers in a specialist field."
            },
            "dct:description": {
                "en-US": "Equivalent to UNESCO ISCED, Level 8, and United States IPEDS Award Level 8."
            },
            "vann:usageNote": {
                "en-US": "Use the name property to capture local variations on what this class covers."
            },
            "vs:term_status": "vs:unstable",
            "rdfs:subClassOf": [
                "ceterms:Degree"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:StructuredStatement",
            "rdfs:label": {
                "en-US": "Structured Statement"
            },
            "rdfs:comment": {
                "en-US": "A statement provided verbatim or by reference, with additional context such as type, source, or citation."
            },
            "vann:usageNote": {
                "en-US": "Do not use a StructureStatement if a property such as ceterms:description is adequate. When using ceterms:StructuredStatement use ceterms:statementText for the text in a document. Use ceterms:description and ceterms:subjectWebpage when a link is needed to the text in a document. The link should be directly to the relevant section of the document."
            },
            "vs:term_status": "vs:unstable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:SupportService",
            "rdfs:label": {
                "en-US": "Support Service"
            },
            "rdfs:comment": {
                "en-US": "Resources and assistance that help people overcome barriers to succeed in their education and career goals."
            },
            "dct:description": {
                "en-US": "Support services can be provided at any stage of an individual's education or career, and may be targeted towards people with or without direct affiliation with an organization. The goal of support services is to provide people with the assistance they need to achieve their full potential.  Examples of Support Services include career advice, job placement, childcare, transportation, tools, mentorship, counseling, and other forms of aid."
            },
            "vs:term_status": "vs:unstable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:Task",
            "rdfs:label": {
                "en-US": "Task"
            },
            "rdfs:comment": {
                "en-US": "Specific activity, typically related to performing a function or achieving a goal."
            },
            "vs:term_status": "vs:stable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:TechnicalLevel1Certificate",
            "rdfs:label": {
                "en-US": "Technical Level 1 Certificate"
            },
            "rdfs:comment": {
                "en-US": "Credential award at a postsecondary level for successful completion of a formal education program that is more than one semester and less than 1 year, demonstrating competencies within a specific subject area or an occupational area indicating job readiness."
            },
            "dct:description": {
                "en-US": "Can lead to a Technical Certificate Level 2 or a degree. Equivalent to a United States IPEDS Award Level 1b that specifies postsecondary certificates of 300-899 clock hours, or 9-29 semester or trimester credit hours, or 13-44 quarter credit hours and UNESCO ISCED 2011 Level 4."
            },
            "vs:term_status": "vs:unstable",
            "rdfs:subClassOf": [
                "ceterms:AcademicCertificate"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:TechnicalLevel2Certificate",
            "rdfs:label": {
                "en-US": "Technical Level 2 Certificate"
            },
            "rdfs:comment": {
                "en-US": "Credential award at a postsecondary level for successful completion of a formal education program that is at least 1 year but less than 2 years, demonstrating competencies within a specific subject area or in an occupational area indicating job readiness."
            },
            "dct:description": {
                "en-US": "Can lead to a degree. Equivalent to a United States IPEDS Award Level 2 that specifies postsecondary certificates of at least 900 but less than 1,800 clock hours, or at least 30 but less than 60 semester or trimester credit hours, or at least 45 but less than 90 quarter credit hours and UNESCO ISCED 2011 Level 4."
            },
            "vs:term_status": "vs:unstable",
            "rdfs:subClassOf": [
                "ceterms:AcademicCertificate"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:TechnicalLevel3Certificate",
            "rdfs:label": {
                "en-US": "Technical Level 3 Certificate"
            },
            "rdfs:comment": {
                "en-US": "Credential award at a postsecondary level for successful completion of a formal education program that is at least 2 years but less than 4 years, demonstrating competencies within specific occupational areas indicating job readiness."
            },
            "dct:description": {
                "en-US": "Can lead to a degree. Equivalent to a United States IPEDS Award Level 4 that specifies certificates of 1,800 or more clock hours, or 60 or more semester or trimester credit hours, or 90 or more quarter credit hours and UNESCO ISCED 2011 Level 5."
            },
            "vs:term_status": "vs:unstable",
            "rdfs:subClassOf": [
                "ceterms:AcademicCertificate"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:TransferAgreement",
            "rdfs:label": {
                "en-US": "Transfer Agreement"
            },
            "rdfs:comment": {
                "en-US": "Formal agreement between two or more parties that specifies how prior learning is recognized, including its transfer and applicability for credit."
            },
            "dct:description": {
                "en-US": "May include articulation agreements, memoranda of understanding, or similar arrangements that govern how learning achievements are recognized across organizations or other boundaries."
            },
            "vs:term_status": "vs:unstable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:TransferIntermediary",
            "rdfs:label": {
                "en-US": "Transfer Intermediary"
            },
            "rdfs:comment": {
                "en-US": "Surrogate resource to which other resources are mapped in order to indicate their common transferability."
            },
            "vann:usageNote": {
                "en-US": "Used when multiple resources such as courses are grouped together to indicate they have mutually agreed upon transfer value."
            },
            "vs:term_status": "vs:unstable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:TransferValueProfile",
            "rdfs:label": {
                "en-US": "Transfer Value Profile"
            },
            "rdfs:comment": {
                "en-US": "Description of learning value from one context when transferred to another."
            },
            "dct:description": {
                "en-US": "The learning value described in a Transfer Value Profile is commonly expressed as credit earned in one context and applied toward another, enabling a person to fulfill requirements without repeating equivalent learning. Other forms of recognition of prior learning, such as competencies or exemptions, may also be described."
            },
            "vann:usageNote": {
                "en-US": "Transfer Value Profile is used to describe learning value in contexts such as recognition of prior learning or transfer. It does not describe the inherent credit value of a resource within the organization that owns or offers it; use ceterms:creditValue with a Value Profile for that purpose."
            },
            "vs:term_status": "vs:stable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:ValueProfile",
            "rdfs:label": {
                "en-US": "Value Profile"
            },
            "rdfs:comment": {
                "en-US": "A description of value awarded for, required by, or otherwise related to the resource."
            },
            "vs:term_status": "vs:stable",
            "rdfs:subClassOf": [
                "schema:QuantitativeValue"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:VerificationServiceProfile",
            "rdfs:label": {
                "en-US": "Verification Service Profile"
            },
            "rdfs:comment": {
                "en-US": "Entity describing the means by which someone can verify whether a credential has been attained."
            },
            "dct:description": {
                "en-US": "Includes, but is not limited to, verification of whether quality assurance credentials have been issued for organizations, learning opportunities, and assessments."
            },
            "vs:term_status": "vs:stable",
            "rdfs:subClassOf": [
                "schema:Intangible"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:WorkBasedLearningCertificate",
            "rdfs:label": {
                "en-US": "Work-Based Learning Certificate"
            },
            "rdfs:comment": {
                "en-US": "Credential awarded for work-based learning and earn-and-learn models that meet standards and are applicable to industry, trades, occupations, and professions."
            },
            "dct:description": {
                "en-US": "Work-based learning includes many types of skills training that are occupation specific including, but not limited to apprenticeships."
            },
            "vs:term_status": "vs:unstable",
            "rdfs:subClassOf": [
                "ceterms:Certificate"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:WorkExperienceComponent",
            "rdfs:label": {
                "en-US": "Work Experience Component"
            },
            "rdfs:comment": {
                "en-US": "Resource describing an activity or training through which a person gains job experience."
            },
            "dct:description": {
                "en-US": "Instances act as proxies or stand-ins for other resources in the context of a particular pathway so that relationships between them as components of that pathway can be stated without implying that the those relationships are true of the resources in other contexts."
            },
            "vs:term_status": "vs:stable",
            "rdfs:subClassOf": [
                "ceterms:PathwayComponent"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:WorkforceDemandAction",
            "rdfs:label": {
                "en-US": "Workforce Demand Action"
            },
            "rdfs:comment": {
                "en-US": "Action taken by an agent asserting that the resource being described has a workforce demand level worthy of note."
            },
            "vs:term_status": "vs:unstable",
            "rdfs:subClassOf": [
                "ceterms:CredentialingAction"
            ]
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:WorkRole",
            "rdfs:label": {
                "en-US": "Work Role"
            },
            "rdfs:comment": {
                "en-US": "Collection of tasks and competencies that embody a particular function in one or more jobs."
            },
            "vs:term_status": "vs:stable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "schema:MonetaryAmount",
            "rdfs:label": {
                "en-US": "Monetary Amount"
            },
            "rdfs:comment": {
                "en-US": "Monetary value or range."
            },
            "vs:term_status": "vs:stable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "schema:QuantitativeValue",
            "rdfs:label": {
                "en-US": "Quantitative Value"
            },
            "rdfs:comment": {
                "en-US": "A point value or interval for product characteristics and other purposes."
            },
            "vann:usageNote": {
                "en-US": "Use in CTDL to describe quantitative values such as minimum and maximum credits or credit hours, etc."
            },
            "vs:term_status": "vs:stable"
        },
        {
            "@type": "rdf:Property",
            "@id": "ceasn:abilityEmbodied",
            "rdfs:label": {
                "en-US": "Ability Embodied"
            },
            "rdfs:comment": {
                "en-US": "Enduring attributes of the individual that influence performance are embodied either directly or indirectly in this resource."
            },
            "vann:usageNote": {
                "en-US": "The abilityEmbodied property may referenced a defined ability in an ontology such as O*NET or an existing competency defined in a competency framework."
            },
            "vs:term_status": "vs:stable",
            "schema:domainIncludes": [
                "ceasn:Competency",
                "ceterms:Job",
                "ceterms:Occupation",
                "ceterms:Task",
