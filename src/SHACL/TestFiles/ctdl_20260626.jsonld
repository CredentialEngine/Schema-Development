            "skos:prefLabel": {
                "en-US": "Doctoral Degree Level"
            },
            "skos:definition": {
                "en-US": "Intended for those who have completed Bachelors and Masters degrees or their equivalent and who will be required to complete either independent research or a significant project or paper."
            },
            "dct:description": {
                "en-US": "Aligns to ISCED 2011 level 8 – Doctoral or equivalent level."
            },
            "vs:term_status": "vs:stable",
            "skos:broader": [
                "audLevel:PostSecondaryLevel"
            ],
            "skos:inScheme": [
                "ceterms:AudienceLevel"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "audLevel:EarlyChildhood",
            "skos:prefLabel": {
                "en-US": "Early Childhood"
            },
            "skos:definition": {
                "en-US": "Intended for children before the start of primary education."
            },
            "dct:description": {
                "en-US": "Aligns to ISCED 2011 level 0 – Early childhood education."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
