            },
            "rdfs:comment": {
                "en-US": "Resource that is a proxy for multiple entities."
            },
            "vann:usageNote": {
                "en-US": "Completion or satisfaction of this Component entails completion or satisfaction of all entities for which this Component is a proxy, unless otherwise indicated by Constraints or other relevant information."
            },
            "vs:term_status": "vs:unstable"
        },
        {
            "@type": "rdfs:Class",
            "@id": "ceterms:Occupation",
