            ],
            "skos:topConceptOf": [
                "ceterms:AudienceLevel"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "audLevel:GraduateLevel",
            "skos:prefLabel": {
                "en-US": "Graduate Level"
            },
            "skos:definition": {
                "en-US": "Intended for those who enrolled in a degree program or other formal program above the baccalaureate level, such as a masters or doctoral degree program."
