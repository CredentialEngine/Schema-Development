        {
            "@type": "rdf:Property",
            "@id": "ceterms:accredits",
            "rdfs:label": {
                "en-US": "Accredits"
            },
            "rdfs:comment": {
                "en-US": "Credential, assessment, organization, or learning opportunity for which this organization provides official authorization or approval based on prescribed standards or criteria."
