            "@id": "ceasn:listID",
            "rdfs:label": {
                "en-US": "List ID"
            },
            "rdfs:comment": {
                "en-US": "An alphanumeric string indicating the relative position of a resource in an ordered list of resources."
            },
            "dct:description": {
                "en-US": "Examples of such strings include: such as \"A\", \"B\", or \"a\", \"b\", or \"I\", \"II\", or \"1\", \"2\"."
            },
            "vann:usageNote": {
                "en-US": "Punctuation accompanying alphanumeric strings should not be included."
