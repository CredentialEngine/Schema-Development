        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Applied",
            "skos:prefLabel": {
                "en-US": "Applied Instruction"
            },
            "skos:definition": {
                "en-US": "Provides learning opportunities in the context of real world examples, cases, and applications."
            },
            "dct:description": {
                "en-US": "Applies to methods such as contextual learning, applied academics, academic-technical integration, problem-based learning, project-based learning, and case methods."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Apprenticeship",
            "skos:prefLabel": {
                "en-US": "Apprenticeship"
            },
            "skos:definition": {
                "en-US": "Learning through work that leads to a credential that is recognized by a relevant authority and is deliberately structured and supported to provide a progression of learning experiences."
            },
            "vs:term_status": "vs:unstable",
            "skos:broader": [
                "learnMethod:WorkBased"
            ],
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:AugmentedReality",
            "skos:prefLabel": {
                "en-US": "Augmented Reality"
            },
            "skos:definition": {
                "en-US": "Provides interactive learning experience through technology that superimposes a computer-generated image on a user's view of the real world, thus providing a composite view."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:ClinicalRotation",
            "skos:prefLabel": {
                "en-US": "Clinical Rotation"
            },
            "skos:definition": {
                "en-US": "Learning through real-world work experience in a medical context under the direct supervision of a qualified practitioner."
            },
            "vs:term_status": "vs:unstable",
            "skos:broader": [
                "learnMethod:WorkBased"
            ],
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:CocurricularLearning",
            "skos:prefLabel": {
                "en-US": "Cocurricular Learning"
            },
            "skos:definition": {
                "en-US": "Learning opportunity that supplements or complements the curriculum."
            },
            "vann:usageNote": {
                "en-US": "Use for activities that are not part of a formal curriculum."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:CohortBased",
            "skos:prefLabel": {
                "en-US": "Cohort-Based"
            },
            "skos:definition": {
                "en-US": "Format in which people  progress as a group."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:CompetencyBased",
            "skos:prefLabel": {
                "en-US": "Competency Based"
            },
            "skos:definition": {
                "en-US": "Method that focuses on learners demonstrating the knowledge, skills and/or attitudes in highly specific units regardless of time, place, or pace of learning, usually in authentic contexts."
            },
            "dct:description": {
                "en-US": "This definition is based on Commonwealth of Learning (COL) \"Open and Distance Learning: Key Terms and Definitions\" (May 2023) http://hdl.handle.net/11599/3558"
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Gaming",
            "skos:prefLabel": {
                "en-US": "Gaming"
            },
            "skos:definition": {
                "en-US": "Provides interactive educational experiences which demonstrate concepts in a way that promotes critical thinking, overcoming challenges within prescribed rule sets, problem solving, and in some cases, teamwork and/or competition."
            },
            "dct:description": {
                "en-US": "Individual or group games that have cognitive, social, behavioral, and/or emotional dimensions which are related to educational objectives."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Internship",
            "skos:prefLabel": {
                "en-US": "Internship"
            },
            "skos:definition": {
                "en-US": "Work position that is intended to provide a learner with an opportunity to gain experience but that is not structured around learning and does not itself lead to a credential recognized by a relevant authority."
            },
            "vs:term_status": "vs:unstable",
            "skos:broader": [
                "learnMethod:WorkBased"
            ],
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Laboratory",
            "skos:prefLabel": {
                "en-US": "Laboratory"
            },
            "skos:definition": {
                "en-US": "Hands-on individual or group experiences for applied learning concepts and methods, procedures and protocols with equipment and technologies."
            },
            "dct:description": {
                "en-US": "Applies to clinical practice and methods such as physical and/or virtual simulation or participation, whether direct or indirect."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Lecture",
            "skos:prefLabel": {
                "en-US": "Lecture"
            },
            "skos:definition": {
                "en-US": "Primary method is presentation by an instructor of learning material and may include student discussion."
            },
            "dct:description": {
                "en-US": "Lecture courses may involve student questions and answers, but the role of the instructor is clearly differentiated from that of the students."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:MedicalResidency",
            "skos:prefLabel": {
                "en-US": "Medical Residency"
            },
            "skos:definition": {
                "en-US": "Learning through real-world work experience at the graduate level in a medical context where a qualified participant works under the direct supervision of a senior practicioner."
            },
            "vs:term_status": "vs:unstable",
            "skos:broader": [
                "learnMethod:WorkBased"
            ],
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Prerecorded",
            "skos:prefLabel": {
                "en-US": "Prerecorded"
            },
            "skos:definition": {
                "en-US": "Learning by using video, audio, or other prerecorded content."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:SelfPaced",
            "skos:prefLabel": {
                "en-US": "Self Paced"
            },
            "skos:definition": {
                "en-US": "Provides for personalization and flexibility in the timing and progression of learning for individual learners based on their preferences and needs, prior learning experiences, and ability to progress through learning opportunities."
            },
            "dct:description": {
                "en-US": "Applies to methods such as competency-based education, open-entry/open exit, independent study, private study, and correspondence."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Seminar",
            "skos:prefLabel": {
                "en-US": "Seminar"
            },
            "skos:definition": {
                "en-US": "Primary method is active student discussion leading to advancement of the topic and facilitated by an instructor."
            },
            "dct:description": {
                "en-US": "Seminars typically involve small groups to facilitate equal opportunity with the instructor and colleagues to be engaged and occasionally may include students leading discussions."
            },
            "vs:term_status": "vs:stable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:Simulation",
            "skos:prefLabel": {
                "en-US": "Simulation"
            },
            "skos:definition": {
                "en-US": "Provides interactive learning experience through imitation of a situation or process."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "learnMethod:WorkBased",
            "skos:prefLabel": {
                "en-US": "Work Based"
            },
            "skos:definition": {
                "en-US": "Provides real-world work experiences that may be paid or unpaid and provided in group or individual formats normally outside the classroom."
            },
            "dct:description": {
                "en-US": "Applies to methods such as apprenticeships, internships, externships, work study, clinical rotations, residencies, practicums, field study, team projects, and cooperative education."
            },
            "vs:term_status": "vs:stable",
            "skos:narrower": [
                "learnMethod:Apprenticeship",
                "learnMethod:ClinicalRotation",
                "learnMethod:Internship",
                "learnMethod:MedicalResidency"
            ],
            "skos:inScheme": [
                "ceterms:LearningMethod"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningMethod"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lifeCycle:Active",
            "skos:prefLabel": {
                "en-US": "Active"
            },
            "skos:definition": {
                "en-US": "Resource is active, current, ongoing, offered, operational, or available."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LifeCycleStatus"
            ],
            "skos:topConceptOf": [
                "ceterms:LifeCycleStatus"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lifeCycle:Ceased",
            "skos:prefLabel": {
                "en-US": "Ceased"
            },
            "skos:definition": {
                "en-US": "Resource is permanently no longer active, current, ongoing, offered, operational, or available."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LifeCycleStatus"
            ],
            "skos:topConceptOf": [
                "ceterms:LifeCycleStatus"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lifeCycle:Ceasing",
            "skos:prefLabel": {
                "en-US": "Ceasing"
            },
            "skos:definition": {
                "en-US": "Resource is in the process of becoming no longer active, current, ongoing, offered, operational, or available."
            },
            "vs:term_status": "vs:unstable",
            "skos:narrower": [
                "lifeCycle:TeachOut"
            ],
            "skos:inScheme": [
                "ceterms:LifeCycleStatus"
            ],
            "skos:topConceptOf": [
                "ceterms:LifeCycleStatus"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lifeCycle:Developing",
            "skos:prefLabel": {
                "en-US": "Developing"
            },
            "skos:definition": {
                "en-US": "Resource is under development and may or may not become active, current, ongoing, offered, operational, or available."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LifeCycleStatus"
            ],
            "skos:topConceptOf": [
                "ceterms:LifeCycleStatus"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lifeCycle:Suspended",
            "skos:prefLabel": {
                "en-US": "Suspended"
            },
            "skos:definition": {
                "en-US": "Resource is temporarily not active, current, ongoing, offered, operational, or available."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LifeCycleStatus"
            ],
            "skos:topConceptOf": [
                "ceterms:LifeCycleStatus"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lifeCycle:TeachOut",
            "skos:prefLabel": {
                "en-US": "Teach Out"
            },
            "skos:definition": {
                "en-US": "Arrangement by which an educational institution provides its current students with the opportunity to complete their course of study when the program, institution or location offering access closes."
            },
            "vs:term_status": "vs:unstable",
            "skos:broader": [
                "lifeCycle:Ceasing"
            ],
            "skos:inScheme": [
                "ceterms:LifeCycleStatus"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "logic:And",
            "skos:prefLabel": {
                "en-US": "And"
            },
            "skos:definition": {
                "en-US": "Relation is satisfied when all of the conditions and constraints are satisfied."
            },
            "vann:usageNote": {
                "en-US": "When used in a Component Condition, this applies to the combination of all immediately subordinate Component Conditions and Constraints."
            },
            "vs:term_status": "vs:unstable",
            "owl:equivalentClass": [
                "odrl2:and"
            ],
            "skos:inScheme": [
                "ceterms:LogicalOperatorCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LogicalOperatorCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "logic:OnlyOne",
            "skos:prefLabel": {
                "en-US": "Only One"
            },
            "skos:definition": {
                "en-US": "Relation is satisfied when exactly one, and not more, of the conditions or constraints is satisfied."
            },
            "vann:usageNote": {
                "en-US": "When used in a Component Condition, this applies to the combination of all immediately subordinate Component Conditions and Constraints."
            },
            "vs:term_status": "vs:unstable",
            "owl:equivalentClass": [
                "odrl2:xone"
            ],
            "skos:inScheme": [
                "ceterms:LogicalOperatorCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LogicalOperatorCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "logic:Or",
            "skos:prefLabel": {
                "en-US": "Or"
            },
            "skos:definition": {
                "en-US": "Relation is satisfied when at least one of the conditions or constraints is satisfied."
            },
            "vann:usageNote": {
                "en-US": "When used in a Component Condition, this applies to the combination of all immediately subordinate Component Conditions and Constraints."
            },
            "vs:term_status": "vs:unstable",
            "owl:equivalentClass": [
                "odrl2:or"
            ],
            "skos:inScheme": [
                "ceterms:LogicalOperatorCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LogicalOperatorCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:AssessmentScore",
            "skos:prefLabel": {
                "en-US": "Assessment Score"
            },
            "skos:definition": {
                "en-US": "Official documentation of a person’s assessment results."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:CompletionRecord",
            "skos:prefLabel": {
                "en-US": "Completion Record"
            },
            "skos:definition": {
                "en-US": "Document verifying successful completion of structured training with an identifiable provider."
            },
            "dct:description": {
                "en-US": "Applies to employer, community-based, military, or continuing education training."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:Credential",
            "skos:prefLabel": {
                "en-US": "Credential"
            },
            "skos:definition": {
                "en-US": "Representation of a credential, digital or non-digital, attesting to a person’s achievements."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:CreditRecommendation",
            "skos:prefLabel": {
                "en-US": "Credit Recommendation"
            },
            "skos:definition": {
                "en-US": "Recommendation for credit or competency value issued by an authoritative evaluating body, including amount, level, and conditions for specified learning."
            },
            "dct:description": {
                "en-US": "In the U.S., common sources include ACE credit recommendations."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:EmployerAttestation",
            "skos:prefLabel": {
                "en-US": "Employer Attestation"
            },
            "skos:definition": {
                "en-US": "Formal statement from an employer verifying duties, scope of work, and performance relevant to claimed learning."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:HoursVerification",
            "skos:prefLabel": {
                "en-US": "Hours Verification"
            },
            "skos:definition": {
                "en-US": "Record confirming supervised practice, clinical hours, or comparable time-based experience."
            },
            "dct:description": {
                "en-US": "Common in clinical, practicum, apprenticeship, or licensure contexts."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:JobVerification",
            "skos:prefLabel": {
                "en-US": "Job Verification"
            },
            "skos:definition": {
                "en-US": "Official role description with verification of incumbency and dates."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:MilitaryTranscript",
            "skos:prefLabel": {
                "en-US": "Military Transcript"
            },
            "skos:definition": {
                "en-US": "Official record of a person’s military education, training, occupations, and related evaluations."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:Portfolio",
            "skos:prefLabel": {
                "en-US": "Portfolio"
            },
            "skos:definition": {
                "en-US": "Curated collection of artifacts evidencing learning typically aligned to defined outcomes."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:ReflectiveNarrative",
            "skos:prefLabel": {
                "en-US": "Reflective Narrative"
            },
            "skos:definition": {
                "en-US": "Structured reflection connecting prior experience to defined competencies or outcomes."
            },
            "dct:description": {
                "en-US": "Often required in portfolio submissions. There may be a requirement for commentary or analysis in the narrative."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:ResumeVerification",
            "skos:prefLabel": {
                "en-US": "Résumé Verification"
            },
            "skos:definition": {
                "en-US": "Structured record of experience and education accompanied by sufficient validation for evaluation."
            },
            "dct:description": {
                "en-US": "Validation may include references, verification letters, or linked evidence."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:SkillProfile",
            "skos:prefLabel": {
                "en-US": "Skill Profile"
            },
            "skos:definition": {
                "en-US": "Document that maps a person’s work artifacts or experiences to specified competencies, learning outcomes, or course requirements."
            },
            "dct:description": {
                "en-US": "Improves defensibility and transparency."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:Syllabus",
            "skos:prefLabel": {
                "en-US": "Syllabus"
            },
            "skos:definition": {
                "en-US": "Document outlining objectives, content, requirements, schedule, and assessment for a specific course."
            },
            "dct:description": {
                "en-US": "Supports content and outcome alignment."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:Transcript",
            "skos:prefLabel": {
                "en-US": "Transcript"
            },
            "skos:definition": {
                "en-US": "Official academic record of a person’s achievements issued by the record holder."
            },
            "dct:description": {
                "en-US": "May be issued by the originating institution or a recognized clearinghouse."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:WorkplaceLearningRecord",
            "skos:prefLabel": {
                "en-US": "Workplace Learning Record"
            },
            "skos:definition": {
                "en-US": "Documentation of a person's on the job learning."
            },
            "dct:description": {
                "en-US": "Includes Apprentice Logbooks and similar."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrEvidence:WorkProduct",
            "skos:prefLabel": {
                "en-US": "Work Product"
            },
            "skos:definition": {
                "en-US": "Substantive work product demonstrating applied knowledge aligned to defined outcomes."
            },
            "dct:description": {
                "en-US": "May include reports, designs, code, media, or presentations."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionEvidenceCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:CreditRecommendationReview",
            "skos:prefLabel": {
                "en-US": "Credit Recommendation Review"
            },
            "skos:definition": {
                "en-US": "An evaluation method that uses an authoritative body’s credit recommendation to determine credit awards."
            },
            "dct:description": {
                "en-US": "In the U.S., examples include American Council on Education (ACE) credit recommendations."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:ExternalTrainingEvaluation",
            "skos:prefLabel": {
                "en-US": "External Training Evaluation"
            },
            "skos:definition": {
                "en-US": "An evaluation method in which structured, external non-academic training is reviewed to award credit or standing."
            },
            "dct:description": {
                "en-US": "May be conducted by employer, third-party, vendor, or external credentialing organization."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:FacultyDevelopedExamination",
            "skos:prefLabel": {
                "en-US": "Faculty-Developed Examination"
            },
            "skos:definition": {
                "en-US": "A method in which learning is assessed by a course-specific exam created and administered by faculty."
            },
            "dct:description": {
                "en-US": "In the United States, examples include challenge exams."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:FacultyTransferEvaluation",
            "skos:prefLabel": {
                "en-US": "Faculty Transfer Evaluation"
            },
            "skos:definition": {
                "en-US": "An evaluation method in which faculty subject-matter experts judge whether prior learning meets course outcomes."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:IndividualizedPriorLearningAssessment",
            "skos:prefLabel": {
                "en-US": "Individualized Prior Learning Assessment"
            },
            "skos:definition": {
                "en-US": "An evaluation method that uses personalized approaches to assess learning."
            },
            "dct:description": {
                "en-US": "Examples include portfolio review, simulation, and interview."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:InstitutionDevelopedAssessment",
            "skos:prefLabel": {
                "en-US": "Institution-Developed Assessment"
            },
            "skos:definition": {
                "en-US": "A method in which institution-created assessments are used to determine credit for prior learning."
            },
            "dct:description": {
                "en-US": "Examples include challenge exams, projects, and labs."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:InternationalCreditEvaluation",
            "skos:prefLabel": {
                "en-US": "International Credit Evaluation"
            },
            "skos:definition": {
                "en-US": "An evaluation method in which learning or credit earned from organizations in other countries is reviewed for recognition."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:PortfolioAssessment",
            "skos:prefLabel": {
                "en-US": "Portfolio Assessment"
            },
            "skos:definition": {
                "en-US": "A method in which a learner-developed portfolio is assessed to evidence prior learning aligned to defined outcomes."
            },
            "dct:description": {
                "en-US": "Examples include documentation, work products, and artifacts mapped to competencies or requirements."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:PriorLearningAssessment",
            "skos:prefLabel": {
                "en-US": "Prior Learning Assessment"
            },
            "skos:definition": {
                "en-US": "A structured method used to evaluate an individual's prior learning and its applicability to requirements."
            },
            "vs:term_status": "vs:unstable",
            "skos:inScheme": [
                "ceterms:LearningRecognitionMethodCategory"
            ],
            "skos:topConceptOf": [
                "ceterms:LearningRecognitionMethodCategory"
            ]
        },
        {
            "@type": "skos:Concept",
            "@id": "lrMethod:ProficiencyExamination",
            "skos:prefLabel": {
                "en-US": "Proficiency Examination"
            },
            "skos:definition": {
                "en-US": "A method in which learning is assessed by an exam used to demonstrate subject mastery for placement or credit."
