            "rdfs:comment": {
                "en-US": "Credential awarded for a graduate level course of study where course work and activities advance skills beyond those of the bachelor's degree or its equivalent, with an emphasis in the liberal arts and sciences such as the humanities and social science fields."
            },
            "dct:description": {
                "en-US": "Equivalent to an award at UNESCO ISCED 2011, Level 7, and United States IPEDS Award Level 7."
