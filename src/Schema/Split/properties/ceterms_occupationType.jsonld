  "rdfs:label": {
    "en-US": "Occupation Type"
  },
  "rdfs:comment": {
    "en-US": "Type of occupation; select from an existing enumeration of such types."
  },
  "vann:usageNote": {
    "en-US": "For U.S. resources, best practice is to identify an occupation using a framework such as the ONet. Other resources may use any framework of the class ceterms:OccupationClassification, such as the EU's ESCO, ISCO-08, and SOC 2010."
  },
