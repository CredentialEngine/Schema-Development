  "@id": "ceterms:Accommodation",
  "rdfs:label": {
    "en-US": "Accommodation"
  },
  "rdfs:comment": {
    "en-US": "Types of features, changes, modifications, or adjustments made to a facility, service, or resource to provide equal access and opportunity to people with diverse needs and preferences."
  },
  "dct:description": {
    "en-US": "These accommodations can include existing physical features or modifications to the environment, alternative formats or modes of communication, flexible scheduling, and personal assistance services, among others."
  },
