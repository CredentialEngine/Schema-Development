{
  "@context": "https://credreg.net/ctdl/schema/context/json",
  "@type": "rdf:Property",
  "@id": "ceterms:versionCode",
  "rdfs:label": {
    "en-US": "Version Code"
  },
  "rdfs:comment": {
    "en-US": "Alphanumeric identifier of the version of the resource that is unique within the organizational context of its owner and which does not need the context of other information in order to be interpreted."
  },
  "vann:usageNote": {
    "en-US": "Intended for simple string and/or numeric version codes or identifiers, such as \"10\" or \"3B.1\" or \"2024 Release\". For version identifiers that need to reference additional information, such as a type of version or framework for versioning, use versionIdentifier."
  },
  "vs:term_status": "vs:unstable",
  "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/versionCode/json",
