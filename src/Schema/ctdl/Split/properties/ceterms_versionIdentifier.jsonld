{
  "@context": "https://credreg.net/ctdl/schema/context/json",
  "@type": "rdf:Property",
  "@id": "ceterms:versionIdentifier",
  "rdfs:label": {
    "en-US": "Version Identifier"
  },
  "rdfs:comment": {
    "en-US": "Alphanumeric identifier of the version of the resource and information about the identifier's originating context or scheme."
  },
  "vann:usageNote": {
    "en-US": "Use versionCode for any local identifier of the version of the resource that come from the organizational context its owner and which do not need the context of other information in order to be interpreted."
  },
  "vs:term_status": "vs:stable",
  "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/versionIdentifier/json",
