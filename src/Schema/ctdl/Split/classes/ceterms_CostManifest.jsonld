  "@id": "ceterms:CostManifest",
  "rdfs:label": {
    "en-US": "Cost Manifest"
  },
  "rdfs:comment": {
    "en-US": "Entity that describes a set of costs maintained at, and applicable across the organizational and/or sub-organizational level."
