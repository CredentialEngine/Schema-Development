        "asn:ProgressionModel",
        "ceasn:CompetencyFramework",
        "ceasn:Rubric",
        "ceasn:RubricCriterion",
        "ceasn:RubricLevel",
        "skos:ConceptScheme"
    ],
    "schema:rangeIncludes": [
        "rdf:langString"
    ],
    "vs:term_status": "vs:stable"
}