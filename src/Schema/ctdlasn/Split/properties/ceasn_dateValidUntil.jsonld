{
    "@context": "https://credreg.net/ctdlasn/schema/context/json",
    "@id": "ceasn:dateValidUntil",
    "@type": "rdf:Property",
    "owl:equivalentProperty": [
        "schema:endDate"
    ],
    "rdfs:comment": {
        "en-US": "End date of validity of this resource."
    },
    "rdfs:label": {
        "en-US": "Date Valid Until"
    },
    "rdfs:subPropertyOf": [
        "dct:valid"
    ],
    "schema:domainIncludes": [
        "ceasn:CompetencyFramework",
        "ceasn:Rubric",
        "ceterms:AlignmentMap",
        "ceterms:QualificationsFramework"
    ],
    "schema:rangeIncludes": [
        "xsd:dateTime"
    ],
    "vann:usageNote": {
        "en-US": "Where the resource is valid for a given period of time, use both the dateValidFrom and dateValidUntil properties."
    },
    "vs:term_status": "vs:stable"
}