    "@id": "ceterms:industryType",
    "@type": "rdf:Property",
    "rdfs:comment": {
        "en-US": "Type of industry; select from an existing enumeration of such types such as the SIC, NAICS, and ISIC classifications."
    },
    "rdfs:label": {
        "en-US": "Industry Type"
    },
