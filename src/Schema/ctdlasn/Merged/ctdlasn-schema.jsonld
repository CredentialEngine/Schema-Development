        {
            "@id": "evalCat:Authority",
            "@type": "skos:Concept",
            "dct:description": {
                "en-US": "Examples include teachers, supervisors, managers, or others with positions over the person or group being evaluated."
            },
            "skos:definition": {
                "en-US": "Evaluator is an agent with authority over the person,  group, or thing being evaluated in the relevant context."
            },
