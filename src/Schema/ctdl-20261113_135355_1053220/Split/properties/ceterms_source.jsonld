    "ceterms:EarningsProfile",
    "ceterms:EmploymentOutcomeProfile",
    "ceterms:HoldersProfile",
    "ceterms:QualificationsFramework",
    "qdata:DataSetDistribution",
    "qdata:DataSetProfile"
  ],
  "schema:rangeIncludes": [
    "xsd:anyURI"
  ]
}