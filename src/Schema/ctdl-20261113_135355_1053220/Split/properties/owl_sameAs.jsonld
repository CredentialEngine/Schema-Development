  "@id": "owl:sameAs",
  "rdfs:label": {
    "en-US": "Same As"
  },
  "rdfs:comment": {
    "en-US": "Links an individual to an individual; such an owl:sameAs statement indicates that two URI references actually refer to the same thing: the individuals have the same \"identity\"."
  },
