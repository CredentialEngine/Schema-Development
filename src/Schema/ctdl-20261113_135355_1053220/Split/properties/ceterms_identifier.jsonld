{
  "@context": "https://credreg.net/ctdl/schema/context/json",
  "@type": "rdf:Property",
  "@id": "ceterms:identifier",
  "rdfs:label": {
    "en-US": "Identifier"
  },
  "rdfs:comment": {
    "en-US": "Alphanumeric token that identifies this resource and information about the token's originating context or scheme."
  },
  "vann:usageNote": {
    "en-US": "Where a specific property for the originating context or scheme exists, such as ceterms:opeID, ceterms:ncesID, ceterms:leiCode, etc., use that property instead of this one. Where the identifier has no nameable originating context or scheme other than that of the resource being identified, ceterms:codedNotation may be used."
  },
  "vs:term_status": "vs:stable",
  "meta:changeHistory": "https://credreg.net/ctdl/termhistory/ceterms/identifier/json",
